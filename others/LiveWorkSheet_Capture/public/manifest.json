{
	"manifest_version": 3,
	"name": "Capture Of LiveWorksheets",
	"version": "1.0",
	"description": "Crea PNG de hojas de Liveworksheets con respuestas y calificación visibles; personaliza ancho, nombre y modo limpio.",
	"permissions": ["storage"],
	"icons": {
		"16": "icon/icon16.png",
		"32": "icon/icon32.png",
		"48": "icon/icon48.png",
		"128": "icon/icon128.png"
	},
	"content_scripts": [
		{
			"matches": ["https://www.liveworksheets.com/worksheet/*", "https://www.liveworksheets.com/es/worksheet/*"],
			"js": ["main.js"],
			"css": ["style.css"]
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon/icon16.png",
			"32": "icon/icon32.png",
			"48": "icon/icon48.png",
			"128": "icon/icon128.png"
		}
	}
}
